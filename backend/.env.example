# Fastify 本地服务地址。一般无需修改。
HOST=127.0.0.1
PORT=3000

# 允许访问后端的前端地址。
CORS_ORIGIN=http://localhost:5173

# 模型供应商与模型统一由服务端配置，支持 openai/deepseek/gemini。
MODEL_PROVIDER=openai
# 可选：明确覆盖当前供应商的默认模型；留空时自动使用对应供应商的默认模型。
MODEL=

# 凭据只允许放在服务端 .env，禁止提交真实密钥。
# 当前供应商缺少对应密钥时服务仍可启动，但消息接口会返回 503。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MODEL_TIMEOUT_MS=30000

# 以下配置等真正接入对应功能时再启用。
# DATABASE_URL=
# JWT_SECRET=
